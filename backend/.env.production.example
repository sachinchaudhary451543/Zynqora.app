# Copy to .env in the production API environment and replace every value.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/family_app?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://app.example.com
SERVER_BASE_URL=https://api.example.com

# S3-compatible object storage
AWS_REGION=us-east-1
AWS_S3_BUCKET=family-app-media
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

# Password recovery email provider (required before enabling email recovery)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=no-reply@example.com

# Real-time calling provider (LiveKit/Agora integration)
REALTIME_PROVIDER=livekit
REALTIME_URL=wss://rtc.example.com
REALTIME_API_KEY=replace-me
REALTIME_API_SECRET=replace-me
