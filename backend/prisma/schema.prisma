generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  name         String
  bio          String?
  avatarUrl    String?
  profileImage String?  // New: Profile picture URL
  bannerImage  String?
  website      String?
  category     String?
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  resetToken   String?
  resetTokenExpiresAt DateTime?
  refreshTokenHash String?
  refreshTokenExpiresAt DateTime?
  recoveryCodeHash String?
  tokenVersion Int @default(0)

  // Privacy settings
  profileVisibility     String @default("PUBLIC")      // PUBLIC, FOLLOWERS_ONLY, PRIVATE
  followersVisibility   String @default("PUBLIC")
  followingVisibility   String @default("PUBLIC")

  posts        Post[]
  following    Follow[] @relation("follower")
  followedBy   Follow[] @relation("following")
  likes        Like[]   @relation("UserLikes")
  comments     Comment[] @relation("UserComments")
  stories      Story[]
  conversations ConversationParticipant[]
  messages     Message[]
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")
  deviceTokens          DeviceToken[]
  circleMemberships     CircleMember[]
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Circle {
  id          String        @id @default(uuid())
  slug        String        @unique
  name        String
  description String?
  icon        String?
  createdAt   DateTime      @default(now())
  members     CircleMember[]
  posts       Post[]
}

model CircleMember {
  id       String   @id @default(uuid())
  circleId String
  userId   String
  joinedAt DateTime @default(now())

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([userId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id])
  following User @relation("following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followerId, createdAt])
  @@index([followingId])
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String
  actorId     String
  type        String
  message     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id])
  actor     User @relation("NotificationActor", fields: [actorId], references: [id])

  @@index([recipientId, read, createdAt])
  @@index([recipientId, createdAt])
}

// Visibility scopes control who can see a post -
// represented as a string: CIRCLE, TREE, FOLLOWERS

model Post {
  id         String         @id @default(uuid())
  authorId   String
  content    String?
  mediaUrl   String?
  mediaType  String?        // "image" | "video" | null
  musicUrl   String?
  musicType  String?        // "audio"
  visibility String         @default("FOLLOWERS")
  circleId   String?
  createdAt  DateTime       @default(now())

  author   User      @relation(fields: [authorId], references: [id])
  circle   Circle?   @relation(fields: [circleId], references: [id], onDelete: SetNull)
  likes    Like[]
  comments Comment[]

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([circleId, createdAt])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id])
  user User @relation("UserLikes", fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([createdAt])
  @@index([postId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id])
  author User @relation("UserComments", fields: [authorId], references: [id])

  @@index([createdAt])
  @@index([postId, createdAt])
  @@index([authorId])
}

model Story {
  id        String   @id @default(uuid())
  authorId  String
  videoUrl  String
  thumbnail String?
  caption   String?
  visibility String @default("FOLLOWERS")  // PUBLIC, FOLLOWERS_ONLY, PRIVATE
  expiresAt DateTime                       // Stories expire after 24 hours
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([expiresAt])
}

model Conversation {
  id        String   @id @default(uuid())
  status    String   @default("PENDING")
  requesterId String?
  createdAt DateTime @default(now())
  participants ConversationParticipant[]
  messages  Message[]
}

model ConversationParticipant {
  id             String @id @default(uuid())
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([conversationId])
  @@index([senderId])
}
